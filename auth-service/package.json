{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "auth:generate": "npx @better-auth/cli generate --output src/db/auth-schema.sql",
    "auth:migrate": "npx @better-auth/cli migrate"
  },
  "dependencies": {
    "better-auth": "1.3.7",
    "express": "4.21.2",
    "pg": "8.13.1",
    "@arcjet/node": "1.0.0-beta.5",
    "dotenv": "16.4.7",
    "cors": "2.8.5"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "tsx": "4.19.2",
    "@types/express": "4.17.21",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "@types/cors": "2.8.17"
  }
}
